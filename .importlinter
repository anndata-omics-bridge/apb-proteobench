[importlinter]
root_packages =
    apb_proteobench
include_external_packages = True

[importlinter:contract:package-dependencies-point-inward]
name = top-level modules compose configuration and calculation children
type = layers
exhaustive = True
containers =
    apb_proteobench
layers =
    cli
    presentation | io
    api
    integration | entrapment
    annotation | workflow
    calculation
    configuration | data

[importlinter:contract:calculation-does-not-know-storage]
name = scientific calculation has no container backend dependency
type = forbidden
source_modules =
    apb_proteobench.calculation
forbidden_modules =
    anndata
    mudata

[importlinter:contract:result-performance-io-is-independent]
name = result-performance IO does not import APB internals
type = forbidden
source_modules =
    apb_proteobench.io
forbidden_modules =
    apb_proteobench.annotation
    apb_proteobench.api
    apb_proteobench.calculation
    apb_proteobench.cli
    apb_proteobench.configuration
    apb_proteobench.data
    apb_proteobench.integration
    apb_proteobench.presentation
    apb_proteobench.workflow
